# Google Gemini AI API Key (Dapatkan di Google AI Studio: https://aistudio.google.com/)
GEMINI_API_KEY=your_gemini_api_key_here

# LinkedIn OAuth 2.0 User Access Token (Scope: w_member_social, openid, profile)
LINKEDIN_ACCESS_TOKEN=your_linkedin_access_token_here

# LinkedIn Author / Person URN (Jalankan 'python generateurn.py' untuk mendapatkan ID akun Anda)
# Format: urn:li:person:abcdef1234
LINKEDIN_PERSON_URN=urn:li:person:your_person_id_here
